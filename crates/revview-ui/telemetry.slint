import { Theme } from "themes.slint";
export component Telemetry inherits Rectangle {
    // OBD-II values
    in property <float> coolant-temp: 0.0;
    in property <float> intake-temp: 0.0;
    in property <float> throttle-position: 0.0;
    in property <float> speed: 0.0;
    in property <float> rpm: 0.0;
    in property <int> speed-unit;
    in property <int> temp-unit;

    background: Theme.panel-bg;

    GridLayout {
        padding: 10px;
        spacing: 10px;

        // Equal-sized columns and rows
        Row {
            Rectangle {
                background: Theme.button-bg;
                border-radius: 10px;

                VerticalLayout {
                    alignment: center;
                    spacing: 6px;

                    Text {
                        text: "COOLANT TEMP";
                        font-size: 16px;
                        font-weight: 800;
                        color: Theme.text-dim;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "\{round(root.coolant-temp)} \{root.temp-unit == 0 ? "°C" : "°F"}";
                        font-size: 36px;
                        font-weight: 900;
                        color: Theme.text;
                        horizontal-alignment: center;
                    }
                }
            }

            Rectangle {
                background: Theme.button-bg;
                border-radius: 10px;

                VerticalLayout {
                    alignment: center;
                    spacing: 6px;

                    Text {
                        text: "INTAKE TEMP";
                        font-size: 16px;
                        font-weight: 800;
                        color: Theme.text-dim;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "\{round(root.intake-temp)} \{root.temp-unit == 0 ? "°C" : "°F"}";
                        font-size: 36px;
                        font-weight: 900;
                        color: Theme.text;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        Row {
            Rectangle {
                background: Theme.button-bg;
                border-radius: 10px;

                VerticalLayout {
                    alignment: center;
                    spacing: 6px;

                    Text {
                        text: "THROTTLE POSITION";
                        font-size: 14px;
                        font-weight: 800;
                        color: Theme.text-dim;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "\{round(root.throttle-position)}%";
                        font-size: 30px;
                        font-weight: 900;
                        color: Theme.accent;
                        horizontal-alignment: center;
                    }
                }
            }

            Rectangle {
                background: Theme.button-bg;
                border-radius: 10px;

                VerticalLayout {
                    alignment: center;
                    spacing: 8px;

                    Text {
                        text: "VEHICLE DATA";
                        font-size: 16px;
                        font-weight: 800;
                        color: Theme.text-dim;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "\{round(root.speed)} \{root.speed-unit == 0 ? "KPH" : "MPH"}";
                        font-size: 32px;
                        font-weight: 900;
                        color: Theme.text;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "\{round(root.rpm)} RPM";
                        font-size: 24px;
                        font-weight: 800;
                        color: Theme.text;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}
