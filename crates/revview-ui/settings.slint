import { Stepper } from "rpm-stepper.slint";
import { Dropdown } from "dropdown.slint";

// One grid cell: label on top, control underneath
component SettingCell inherits VerticalLayout {
    in property <string> label;
    spacing: 4px;

    Text {
        text: root.label;
        font-size: 14px;
        font-weight: 800;
        color: #ffffff;
    }

    @children
}

// Two-option toggle, fills the width of its cell
component Segmented inherits Rectangle {
    in property <string> left-text;
    in property <string> right-text;
    in-out property <int> value: 0;
    callback changed();

    height: 36px;
    background: #171a20;
    border-color: #354152;
    border-width: 1px;
    border-radius: 8px;

    HorizontalLayout {
        spacing: 2px;

        Rectangle {
            border-radius: 6px;
            background: root.value == 0 ? #354152 : transparent;
            Text {
                text: root.left-text;
                font-size: 15px;
                font-weight: 800;
                color: root.value == 0 ? #00ffcc : #8b95a5;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                clicked => { root.value = 0; root.changed(); }
            }
        }

        Rectangle {
            border-radius: 6px;
            background: root.value == 1 ? #354152 : transparent;
            Text {
                text: root.right-text;
                font-size: 15px;
                font-weight: 800;
                color: root.value == 1 ? #00ffcc : #8b95a5;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                clicked => { root.value = 1; root.changed(); }
            }
        }
    }
}

export component Settings inherits Rectangle {
    callback settings-changed();
    callback back();

    in-out property <int> speed-unit: 0;   // 0 = Kph, 1 = Mph
    in-out property <int> temp-unit: 0;    // 0 = C, 1 = F
    in-out property <int> redline-rpm: 6500;
    in-out property <int> shift-rpm: 6500;
    in-out property <int> gauge-style: 0;

    // Scroll height = rows * cell-height + gaps. Update when you add a row.
    property <length> cell-height: 58px;
    property <length> grid-spacing: 12px;
    property <int> row-count: 3;

    background: transparent;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        // Scrollable settings grid
        Flickable {
            vertical-stretch: 1;
            content-height: root.row-count * root.cell-height
                + (root.row-count - 1) * root.grid-spacing;

            GridLayout {
                spacing-horizontal: 12px;
                spacing-vertical: root.grid-spacing;

                Row {
                    SettingCell {
                        label: "Speed Units";
                        Segmented {
                            left-text: "KPH";
                            right-text: "MPH";
                            value <=> root.speed-unit;
                            changed => { root.settings-changed(); }
                        }
                    }

                    SettingCell {
                        label: "Temperature Units";
                        Segmented {
                            left-text: "°C";
                            right-text: "°F";
                            value <=> root.temp-unit;
                            changed => { root.settings-changed(); }
                        }
                    }
                }

                Row {
                    SettingCell {
                        label: "Redline";
                        Stepper {
                            value <=> root.redline-rpm;
                            minimum: 3000;
                            maximum: 10000;
                            step: 500;
                            suffix: " rpm";
                            edited(v) => { root.settings-changed(); }
                        }
                    }

                    SettingCell {
                        label: "Shift Indicator";
                        Stepper {
                            value <=> root.shift-rpm;
                            minimum: 3000;
                            maximum: 10000;
                            step: 500;
                            suffix: " rpm";
                            edited(v) => { root.settings-changed(); }
                        }
                    }
                }

                Row {
                    SettingCell {
                        label: "Gauge Style";
                        Dropdown {
                            model: ["Bar", "Arc", "Digital"];
                            current-index <=> root.gauge-style;
                            selected(i) => { root.settings-changed(); }
                        }
                    }
                }
            }
        }

        // Pinned back button
        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 100px;
                height: 36px;
                border-radius: 8px;
                background: back-touch.pressed ? #45475a : #2a2b36;
                border-color: #354152;
                border-width: 1px;

                Text {
                    text: "Back";
                    font-size: 16px;
                    font-weight: 800;
                    color: #00ffcc;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                back-touch := TouchArea {
                    clicked => { root.back(); }
                }
            }
        }
    }
}
