import { Stepper } from "rpm-stepper.slint";

export component Settings inherits Rectangle {
    callback settings-changed();
    callback back();

    in-out property <int> speed-unit: 0; // 0 = Kph, 1 = Mph
    in-out property <int> temp-unit: 0; // 0 = C, 1 = F
    in-out property <int> redline-rpm: 6500;

    // Shared sizes so every row lines up
    property <length> label-width: 130px;
    property <length> control-width: 150px;

    background: transparent;

    VerticalLayout {
        alignment: center;
        spacing: 12px;
        padding: 12px;

        // Page heading
        Text {
            text: "Settings";
            font-size: 32px;
            font-weight: 900;
            color: #ffffff;
            horizontal-alignment: center;
        }

        // Speed unit setting
        HorizontalLayout {
            alignment: center;
            spacing: 16px;

            Text {
                text: "Speed Units";
                width: root.label-width;
                font-size: 16px;
                font-weight: 800;
                color: #ffffff;
                horizontal-alignment: right;
                vertical-alignment: center;
            }

            // Segmented control background
            Rectangle {
                width: root.control-width;
                background: #171a20;
                border-color: #354152;
                border-width: 1px;
                border-radius: 8px;

                HorizontalLayout {
                    spacing: 2px;

                    // KPH
                    Rectangle {
                        height: 36px;
                        border-radius: 6px;

                        background: root.speed-unit == 0
                            ? #354152
                            : transparent;

                        Text {
                            text: "KPH";
                            font-size: 15px;
                            font-weight: 800;
                            color: root.speed-unit == 0
                                ? #00ffcc
                                : #8b95a5;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            clicked => {
                                root.speed-unit = 0;
                                root.settings-changed();
                            }
                        }
                    }

                    // MPH
                    Rectangle {
                        height: 36px;
                        border-radius: 6px;

                        background: root.speed-unit == 1
                            ? #354152
                            : transparent;

                        Text {
                            text: "MPH";
                            font-size: 15px;
                            font-weight: 800;
                            color: root.speed-unit == 1
                                ? #00ffcc
                                : #8b95a5;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            clicked => {
                                root.speed-unit = 1;
                                root.settings-changed();
                            }
                        }
                    }
                }
            }
        }

        // Temperature unit setting
        HorizontalLayout {
            alignment: center;
            spacing: 16px;

            Text {
                text: "Temperature Units";
                width: root.label-width;
                font-size: 16px;
                font-weight: 800;
                color: #ffffff;
                horizontal-alignment: right;
                vertical-alignment: center;
            }

            // Segmented control background
            Rectangle {
                width: root.control-width;
                background: #171a20;
                border-color: #354152;
                border-width: 1px;
                border-radius: 8px;

                HorizontalLayout {
                    spacing: 2px;

                    // Celsius
                    Rectangle {
                        height: 36px;
                        border-radius: 6px;

                        background: root.temp-unit == 0
                            ? #354152
                            : transparent;

                        Text {
                            text: "°C";
                            font-size: 15px;
                            font-weight: 800;
                            color: root.temp-unit == 0
                                ? #00ffcc
                                : #8b95a5;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            clicked => {
                                root.temp-unit = 0;
                                root.settings-changed();
                            }
                        }
                    }

                    // Fahrenheit
                    Rectangle {
                        height: 36px;
                        border-radius: 6px;

                        background: root.temp-unit == 1
                            ? #354152
                            : transparent;

                        Text {
                            text: "°F";
                            font-size: 15px;
                            font-weight: 800;
                            color: root.temp-unit == 1
                                ? #00ffcc
                                : #8b95a5;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            clicked => {
                                root.temp-unit = 1;
                                root.settings-changed();
                            }
                        }
                    }
                }
            }
        }

        // Redline setting
        HorizontalLayout {
            alignment: center;
            spacing: 16px;

            Text {
                text: "Redline";
                width: root.label-width;
                font-size: 16px;
                font-weight: 800;
                color: #ffffff;
                horizontal-alignment: right;
                vertical-alignment: center;
            }

            Stepper {
                width: root.control-width;
                value <=> root.redline-rpm;
                minimum: 3000;
                maximum: 10000;
                step: 500;
                suffix: " rpm";
                edited(v) => { root.settings-changed(); }
            }
        }

        // Back button
        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 100px;
                height: 36px;
                border-radius: 8px;
                background: back-touch.pressed ? #45475a : #2a2b36;
                border-color: #354152;
                border-width: 1px;

                Text {
                    text: "< Back";
                    font-size: 16px;
                    font-weight: 800;
                    color: #00ffcc;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                back-touch := TouchArea {
                    clicked => { root.back(); }
                }
            }
        }
    }
}
