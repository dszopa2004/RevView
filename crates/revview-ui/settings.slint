
export component Settings inherits Rectangle {
    in-out property <int> speed-unit: 0; // 0 = Kph, 1 = Mph

    background: transparent;

    VerticalLayout {
        alignment: center;
        spacing: 24px;
        padding: 16px;

        // Page heading
        Text {
            text: "Settings";
            font-size: 32px;
            font-weight: 900;
            color: #ffffff;
            horizontal-alignment: center;
        }

        // Speed unit setting
        HorizontalLayout {
            alignment: center;
            spacing: 16px;

            Text {
                text: "Speed Units";
                font-size: 20px;
                font-weight: 800;
                color: #ffffff;
                vertical-alignment: center;
            }

            // Segmented control background
            Rectangle {
                background: #171a20;
                border-color: #354152;
                border-width: 1px;
                border-radius: 8px;

                HorizontalLayout {
                    spacing: 2px;

                    // KPH
                    Rectangle {
                        width: 65px;
                        height: 36px;
                        border-radius: 6px;

                        background: root.speed-unit == 0
                            ? #354152
                            : transparent;

                        Text {
                            text: "KPH";
                            font-size: 15px;
                            font-weight: 800;
                            color: root.speed-unit == 0
                                ? #00ffcc
                                : #8b95a5;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            clicked => {
                                root.speed-unit = 0;
                            }
                        }
                    }

                    // MPH
                    Rectangle {
                        width: 65px;
                        height: 36px;
                        border-radius: 6px;

                        background: root.speed-unit == 1
                            ? #354152
                            : transparent;

                        Text {
                            text: "MPH";
                            font-size: 15px;
                            font-weight: 800;
                            color: root.speed-unit == 1
                                ? #00ffcc
                                : #8b95a5;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            clicked => {
                                root.speed-unit = 1;
                            }
                        }
                    }
                }
            }
        }
    }
}
