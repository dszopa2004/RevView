export component Dashboard inherits Window {
    width: 480px;
    height: 320px;
    background: #171a20;

    VerticalLayout {
        alignment: center;
        spacing: 12px;

        Text {
            text: "RevView";
            color: #ffffff;
            font-size: 24px;
            font-weight: 700;
        }

        Text {
            text: "2000 RPM";
            color: #00d4ff;
            font-size: 48px;
            font-weight: 700;
        }

        Text {
            text: "Speed: 45 km/h";
            color: #ffffff;
            font-size: 20px;
        }

        Text {
            text: "Coolant: 88 °C";
            color: #ffffff;
            font-size: 20px;
        }
    }
}