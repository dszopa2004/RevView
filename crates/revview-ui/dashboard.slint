// Defines the visual layout, widgets, colors, and presentation of the dashboard.

import { HorizontalBox, VerticalBox } from "std-widgets.slint";
export component Dashboard inherits Window {
    width: 480px;
    height: 320px;
    background: #171a20;

    // Expose properties that can be set dynamically in code
    in-out property <bool> obd-connected: false;
    in-out property <float> rpm: 0.0;
    in-out property <float> speed: 0.0;

    VerticalLayout {
        alignment: center;
        spacing: 12px;

        // Top Header Bar
        HorizontalBox {
            padding: 0;
            Text {
                text: "RevView";
                font-size: 20px;
                font-weight: 800;
                color: #00ffcc;
            }

            Text {
                text: root.obd-connected ? "OBD-II Connected" : "Disconnected";
                font-size: 14px;
                color: #4ade80;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        // --- Speed Container ---
        VerticalBox {
            alignment: center;

            HorizontalLayout {
                alignment: center;
                spacing: 8px; // Space between the texts

                Text {
                    text: "\{round(root.speed)}";
                    font-size: 48px;
                    font-weight: 900;
                    color: #ffffff;
                    vertical-alignment: bottom;
                }

                Text {
                    text: "Kph";
                    font-size: 16px;
                    font-weight: 900;
                    color: #ffffff;
                    vertical-alignment: center;
                }
            }
        } // --- Speed Container ---

        // --- RPM Container ---
        VerticalBox {
            alignment: center;

            // Simple progress bar
            Rectangle {
                height: 32px; // Thickness of progress bar
                background: #2e3748;
                border-radius: 4px;
                Rectangle {
                    x: 0;
                    width: parent.width * (root.rpm / 8000.0); // Assuming 8k max RPM
                            background: root.rpm > 6000.0 ? #ef4444 : #00ffcc;
                    border-radius: 4px;
                }
            }

            HorizontalLayout {
                alignment: center;
                spacing: 8px; // Space between the texts

                Text {
                    text: "\{round(root.rpm)}";
                    font-size: 48px;
                    font-weight: 900;
                    color: root.rpm > 6000.0 ? #ef4444 : #ffffff; // Change to red when approaching redline
                    vertical-alignment: bottom;
                }

                Text {
                    text: "RPM";
                    font-size: 16px;
                    font-weight: 900;
                    color: root.rpm > 6000.0 ? #ef4444 : #ffffff; // Change to red when approaching redline
                    vertical-alignment: center;
                }
            }
        } // --- RPM Container ---
    }
}
