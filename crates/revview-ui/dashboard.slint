
import { HorizontalBox, VerticalBox, Button } from "std-widgets.slint";
import { Telemetry } from "telemetry.slint";
import { Speedometer } from "speedometer.slint";
import { Settings } from "settings.slint";
import { Diagnostics } from "diagnostics.slint";

export component Dashboard inherits Window {
    preferred-width: 480px;
    preferred-height: 320px;
    default-font-size: min(self.width / 480px, self.height / 320px) * 10px;

    min-width: 480px;
    min-height: 320px;

    maximized: true;
    background: #171a20;

    callback settings-changed();

    // OBD-II Properties
    in-out property <bool> obd-connected: false;
    in-out property <bool> obd-initialized: false;
    in-out property <string> obd-initialization-error: "";
    in-out property <float> rpm: 0.0;
    in-out property <float> speed: 0.0;
    in-out property <int> current-view: 0;
    in-out property <float> coolant-temp: 0.0;
    in-out property <float> intake-temp: 0.0;
    in-out property <float> throttle-position: 0.0;
    in-out property <int> redline-rpm;
    in-out property <int> shift-rpm;
    in-out property <int> gauge-style;

    in-out property <int> speed-unit: 0; // 0 = KPH, 1 = MPH
    in-out property <int> temp-unit: 0; // 0 = C, 1 = F

    in-out property <bool> show-settings: false;
    out property <int> max-view: 2;
    out property <int> min-view: 0;
    property <length> margin: 36px;

    // --- Main Dashboard ---
    if !root.obd-initialized && !root.show-settings: Rectangle {
        x: root.margin;
        y: root.margin;
        width: parent.width - 2 * root.margin;
        height: parent.height - 2 * root.margin;

        background: #202630;
        border-color: #354152;
        border-width: 1px;
        border-radius: 16px;

        HorizontalLayout {
            padding: 12px;
            spacing: 6px;

            // --- Left Navigation ---
            Rectangle {
                horizontal-stretch: 0.35;
                min-width: 28px;
                background: left-touch.pressed ? #45475a : #2a2b36;
                border-radius: 8px;

                Text {
                    text: "<";
                    font-size: 24px;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                left-touch := TouchArea {
                    clicked => {
                        root.current-view -= 1;
                        if root.current-view < min-view {
                            root.current-view = max-view;
                        }
                    }
                }
            }

            // --- Center Dashboard ---
            Rectangle {
                horizontal-stretch: 9.3;
                background: #1e1e2e;
                border-radius: 10px;

                if root.current-view == 0: Speedometer {
                    obd-connected: root.obd-connected;
                    rpm: root.rpm;
                    speed: root.speed;
                    speed-unit: root.speed-unit;
                    redline-rpm: root.redline-rpm;
                    shift-rpm: root.shift-rpm;
                    gauge-style: root.gauge-style;
                }

                if root.current-view == 1: Telemetry {
                    coolant-temp: root.coolant-temp;
                    intake-temp: root.intake-temp;
                    throttle-position: root.throttle-position;
                    speed: root.speed;
                    rpm: root.rpm;
                    speed-unit: root.speed-unit;
                    temp-unit: root.temp-unit;
                }

                if root.current-view == 2: Diagnostics { }
            }

            // --- Right Navigation ---
            Rectangle {
                horizontal-stretch: 0.35;
                min-width: 28px;
                background: right-touch.pressed ? #45475a : #2a2b36;
                border-radius: 8px;

                Text {
                    text: ">";
                    font-size: 24px;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                right-touch := TouchArea {
                    clicked => {
                        root.current-view += 1;
                        if root.current-view > max-view {
                            root.current-view = min-view;
                        }
                    }
                }
            }
        }
    }

    // --- Footer ---
    Text {
        text: "--- RevView ---";
        font-size: 12px;
        font-weight: 800;
        color: #00ffcc;
        horizontal-alignment: center;

        x: 0px;
        width: parent.width;
        y: parent.height - root.margin + (root.margin - self.height) / 2;
    }

    if !root.obd-initialized && root.show-settings: Rectangle {
        x: root.margin;
        y: root.margin;
        width: parent.width - 2 * root.margin;
        height: parent.height - 2 * root.margin;
        background: #202630;
        border-color: #354152;
        border-width: 1px;
        border-radius: 16px;

        // Set setting callback here
        Settings {
            speed-unit <=> root.speed-unit;
            temp-unit <=> root.temp-unit;
            redline-rpm <=> root.redline-rpm;
            shift-rpm <=> root.shift-rpm;
            gauge-style <=> root.gauge-style;
            settings-changed => { root.settings-changed(); }
            back => { root.show-settings = false; }
        }
    }

    // --- Top Settings Button ---
if !root.obd-initialized && !root.show-settings: Rectangle {
    // Hit area: window corner, reaching 12px down into the card's inner padding
    width: 56px;
        height: 36px;
        x: 0px;
        y: 0px;
        background: transparent;

        // Visible button, 8px from the left and top edges
        Rectangle {
            width: 28px;
            height: 28px;
            x: 8px;
            y: 8px;
            border-radius: 6px;
            background: gear-touch.pressed ? #45475a : #2a2b36;
            border-color: #354152;
            border-width: 1px;

            Text {
                text: "⚙";
                font-size: 12px;
                color: #8b95a5;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        gear-touch := TouchArea {
            clicked => { root.show-settings = true; }
        }
    }

    // --- Error Menu ---
    if root.obd-initialized: Rectangle {
        x: root.margin;
        y: root.margin;
        width: parent.width - 2 * root.margin;
        height: parent.height - 2 * root.margin;

        background: #202630;
        border-color: #354152;
        border-width: 1px;
        border-radius: 16px;

        VerticalLayout {
            alignment: center;
            spacing: 24px;

            VerticalBox {
                spacing: 24px;

                Text {
                    text: "RevView Dashboard";
                    font-size: 36px;
                    color: #4ade80;
                    horizontal-alignment: center;
                }

                VerticalBox {
                    spacing: 6px;

                    Text {
                        text: root.obd-connected
                            ? "OBD-II Connected"
                            : "OBD-II Disconnected";
                        font-size: 28px;
                        color: #4ade80;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: root.obd-connected
                            ? ""
                            : "Make sure your OBD-II adapter is plugged in.";
                        font-size: 12px;
                        color: #4ade80;
                        horizontal-alignment: center;
                    }
                }

                VerticalBox {
                    spacing: 6px;

                    Text {
                        text: root.obd-initialized
                            ? "OBD-II Initialized"
                            : "OBD-II Uninitialized";
                        font-size: 28px;
                        color: #4ade80;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: root.obd-initialization-error;
                        font-size: 12px;
                        color: #4ade80;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}
