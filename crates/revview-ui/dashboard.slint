// Defines the visual layout, widgets, colors, and presentation of the dashboard.

import { HorizontalBox, VerticalBox } from "std-widgets.slint";
export component Dashboard inherits Window {
    width: 480px;
    height: 320px;
    background: #171a20;
    // Expose properties that can be set dynamically in code
    in-out property <float> rpm: 0.0;
    in-out property <float> speed: 0.0;

    VerticalLayout {
        alignment: center;
        spacing: 12px;

        // Top Header Bar
        HorizontalBox {
            padding: 0;
            Text {
                text: "RevView";
                font-size: 20px;
                font-weight: 800;
                color: #00ffcc;
            }

            Text {
                text: "OBD-II CONNECTED";
                font-size: 14px;
                color: #4ade80;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        VerticalBox {
            alignment: center;
            Text {
                text: "ENGINE RPM";
                font-size: 14px;
                color: #94a3b8;
                horizontal-alignment: center;
            }

            Text {
                text: "\{round(root.rpm)}";
                font-size: 54px;
                font-weight: 900;
                color: root.rpm > 6000.0 ? #ef4444 : #ffffff; // Change to red when approaching redline
                horizontal-alignment: center;
            }

            // Simple progress bar mock up
                    Rectangle {
                height: 8px;
                background: #2e3748;
                border-radius: 4px;
                Rectangle {
                    x: 0;
                    width: parent.width * (root.rpm / 8000.0); // Assuming 8k max RPM
                            background: root.rpm > 6000.0 ? #ef4444 : #00ffcc;
                    border-radius: 4px;
                }
            }
        }

        Text {
            text: "Speed: 45 km/h";
            color: #ffffff;
            font-size: 20px;
        }

        Text {
            text: "Coolant: 88 °C";
            color: #ffffff;
            font-size: 20px;
        }
    }
}
