// Defines the visual layout, widgets, colors, and presentation of the dashboard.

import { HorizontalBox, VerticalBox } from "std-widgets.slint";
export component Dashboard inherits Window {
    width: 480px;
    height: 320px;
    background: #171a20;

    // Expose properties that can be set dynamically in code
    in-out property <bool> obd-connected: false;
    in-out property <bool> obd-initialized: false;
    in-out property <string> obd-initialization-error: "";
    in-out property <float> rpm: 0.0;
    in-out property <float> speed: 0.0;

    // --- Telemetry Dashboard ---
if !root.obd-initialized: Rectangle {
        width: parent.width;
        height: parent.height;

        // --- Main Telemetry Layout ---
    VerticalLayout {
            alignment: center;
            spacing: 12px;

            // --- Speed Container ---
        VerticalBox {
                alignment: center;

                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;

                    Text {
                        text: "\{round(root.speed)}";
                        font-size: 56px;
                        font-weight: 900;
                        color: #ffffff;
                        vertical-alignment: bottom;
                    }

                    Text {
                        text: "Kph";
                        font-size: 24px;
                        font-weight: 900;
                        color: #ffffff;
                        vertical-alignment: center;
                    }
                }
            }

            // --- RPM Container ---
        VerticalBox {
                alignment: center;

                Rectangle {
                    height: 32px;
                    background: #2e3748;
                    border-radius: 4px;

                    Rectangle {
                        x: 0;
                        width: parent.width * (root.rpm / 8000.0);
                        background: root.rpm > 6000.0 ? #ef4444 : #00ffcc;
                        border-radius: 4px;
                    }
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;

                    Text {
                        text: "\{round(root.rpm)}";
                        font-size: 48px;
                        font-weight: 900;
                        color: root.rpm > 6000.0 ? #ef4444 : #ffffff;
                        vertical-alignment: bottom;
                    }

                    Text {
                        text: "RPM";
                        font-size: 16px;
                        font-weight: 900;
                        color: root.rpm > 6000.0 ? #ef4444 : #ffffff;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // --- Footer ---
    Text {
            text: "--- RevView ---";
            font-size: 12px;
            font-weight: 800;
            color: #00ffcc;
            horizontal-alignment: center;

            x: 0px;
            width: parent.width;
            y: parent.height - self.height - 6px;
        }
    }
    // --- Telemetry Dashboard
    
    // Error Menu
    if root.obd-initialized: VerticalLayout {
        alignment: center;

        VerticalBox {
            spacing: 24px;

            Text {
                text: "Could not start dashboard!";
                font-size: 36px;
                color: #4ade80;
                horizontal-alignment: center;
            }

            VerticalBox {
                spacing: 6px;

                Text {
                    text: root.obd-connected ? "OBD-II Connected" : "OBD-II Disconnected";
                    font-size: 28px;
                    color: #4ade80;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.obd-connected ? "" : "Make sure your OBD-II adapter is plugged in.";
                    font-size: 12px;
                    color: #4ade80;
                    horizontal-alignment: center;
                }
            }

            VerticalBox {
                spacing: 6px;

                Text {
                    text: root.obd-initialized ? "OBD-II Initialized" : "OBD-II Uninitialized";
                    font-size: 28px;
                    color: #4ade80;
                    horizontal-alignment: center;
                }

                Text {
                    text: obd-initialization-error;
                    font-size: 12px;
                    color: #4ade80;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
