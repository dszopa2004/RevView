import { VerticalBox, HorizontalBox } from "std-widgets.slint";

export component Speedometer inherits Rectangle {
    in property <bool> obd-connected;
    in property <float> rpm;
    in property <float> speed;
    VerticalBox {
        // --- Speed Container ---
        VerticalBox {
            alignment: center;

            HorizontalLayout {
                alignment: center;
                spacing: 8px;

                Text {
                    text: "\{round(root.speed)}";
                    font-size: 84px;
                    font-weight: 900;
                    color: #ffffff;
                    vertical-alignment: bottom;
                }

                Text {
                    text: "Kph";
                    font-size: 32px;
                    font-weight: 900;
                    color: #ffffff;
                    vertical-alignment: center;
                }
            }
        }

        // --- RPM Container ---
        VerticalBox {
            alignment: center;

            Rectangle {
                height: 32px;
                background: #2e3748;
                border-radius: 4px;

                Rectangle {
                    x: 0;
                    width: parent.width * (root.rpm / 8000.0);
                    background: root.rpm > 6000.0 ? #ef4444 : #00ffcc;
                    border-radius: 4px;
                }
            }

            HorizontalLayout {
                alignment: center;
                spacing: 8px;

                Text {
                    text: "\{round(root.rpm)}";
                    font-size: 48px;
                    font-weight: 900;
                    color: root.rpm > 6000.0 ? #ef4444 : #ffffff;
                    vertical-alignment: bottom;
                }

                Text {
                    text: "RPM";
                    font-size: 16px;
                    font-weight: 900;
                    color: root.rpm > 6000.0 ? #ef4444 : #ffffff;
                    vertical-alignment: center;
                }
            }
        }
    }
}
